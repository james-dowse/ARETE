generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Movement {
  id               String             @id
  name             String
  bioType          String
  complexity       String
  equipment        String?
  description      String?
  imageUrl         String?
  videoUrl         String?
  // Mouvement personnalisé créé "à la volée" par un utilisateur (nom + vidéo
  // seulement, id "custom-xxx") — jamais retourné par la recherche générale de
  // GET /api/movements, pour ne pas polluer la bibliothèque partagée.
  custom           Boolean            @default(false)
  createdByUserId  String?
  workoutMovements WorkoutMovement[]
  favorites        FavoriteMovement[]

  @@index([name])
  @@index([custom, name])
}

model Workout {
  id          String            @id @default(cuid())
  name        String
  createdAt   DateTime          @default(now())
  duration    Int?
  notes       String?
  description String?
  imageUrl      String?
  imagePosition String? // "x% y%" (object-position CSS), null = centre par defaut
  templateId  String?
  userId      String?
  blockRest   Int?
  tags        String?
  public      Boolean           @default(false)
  // Difficulté forcée manuellement en édition — null = calcul auto
  // (computeWorkoutDifficulty) à partir des mouvements. Valeur libre parmi
  // COMPLEXITIES (Admin > Référentiels).
  difficultyOverride String?
  // Version de séance (voir lib/cuts.ts) : la séance d'origine, et la règle de
  // coupe en JSON ({ rule, label, sourceHash, ownHash }). null = séance ordinaire.
  // SetNull : supprimer l'origine ne supprime ni la version ni ses sessions.
  derivedFromId String?
  cut           String?
  derivedFrom   Workout?          @relation("WorkoutVersions", fields: [derivedFromId], references: [id], onDelete: SetNull)
  versions      Workout[]         @relation("WorkoutVersions")
  movements   WorkoutMovement[]
  blocks      WorkoutBlock[]
  shares      WorkoutShare[]
  savedBy     SavedWorkout[]
  favoritedBy FavoriteWorkout[]
  planEntries WeekPlanEntry[]
  sessions    WorkoutSession[]
  assignments AssignedWorkout[]
  template    WorkoutTemplate?  @relation(fields: [templateId], references: [id])
  user        InvitedUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  // SQLite n'indexe pas les clés étrangères automatiquement : sans ces index,
  // chaque filtre de liste et chaque jointure faisait un parcours complet de
  // table — et chaque suppression en cascade aussi.
  @@index([userId, createdAt])
  @@index([public, createdAt])
  @@index([templateId])
  @@index([derivedFromId])
}

model WorkoutBlock {
  id           String            @id @default(cuid())
  workoutId    String
  order        Int
  bioType      String? // le NOM du bloc (saisi en capitales), pas un type anatomique
  instructions String?
  restAfter    Int?
  superset     Boolean           @default(false)
  // Régime d'enchaînement du bloc, exclusif de `superset` — l'exclusion est
  // tenue par les routes (POST /api/workouts, POST et PATCH de bloc), pas par
  // une contrainte SQL que SQLite ne saurait pas exprimer simplement.
  // superset : un tour = tous les mouvements, répété `sets` fois.
  // dropset  : une descente = tous les paliers sans repos, répétée `sets` fois.
  // Même forme en base, même exécution ; ce qui change est l'intention affichée
  // et les règles de cohérence appliquées en édition.
  // À ne pas confondre avec `role` ci-dessous : le régime dit COMMENT on
  // enchaîne, le rôle dit À QUOI SERT le bloc. Les deux cohabitent.
  dropset      Boolean           @default(false)
  // Rôle fonctionnel (lib/block-role.ts) : echauffement, mobilite, force,
  // conditionnement, accessoire, calme. null = déduit du nom, à confirmer.
  role         String?
  // Regroupement facultatif de blocs, nommé par l'utilisateur (« PUSH »).
  // Une SECTION est la suite de blocs CONSÉCUTIFS portant le même nom : pas de
  // table, donc rien à remapper quand une séance est copiée ou coupée en
  // version, et une section vidée par une coupe disparaît d'elle-même au lieu
  // de laisser une ligne orpheline. Deux suites séparées du même nom restent
  // deux sections distinctes, ce qui est le comportement voulu.
  // Purement organisationnel : n'change rien au déroulé de la séance.
  section      String?
  workout      Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  movements    WorkoutMovement[]

  @@index([workoutId, order])
}

model WorkoutMovement {
  id         String        @id @default(cuid())
  workoutId  String
  movementId String
  order      Int
  sets       Int?
  reps       String?
  rest       Int?
  duration   Int?
  blockId    String?
  movement   Movement      @relation(fields: [movementId], references: [id])
  workout    Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  block      WorkoutBlock? @relation(fields: [blockId], references: [id])

  @@index([workoutId, order])
  @@index([blockId])
  @@index([movementId])
}

model WorkoutTemplate {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  userId    String?
  blocks    TemplateBlock[]
  workouts  Workout[]
  user      InvitedUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model TemplateBlock {
  id         String          @id @default(cuid())
  templateId String
  bioType    String?
  complexity String?
  equipments String?
  count      Int
  order      Int
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model InvitedUser {
  id             String            @id @default(cuid())
  email          String            @unique
  token          String            @unique @default(cuid())
  loginToken     String?           @unique
  loginTokenExp  DateTime?
  status         String            @default("pending")
  invitedAt      DateTime          @default(now())
  acceptedAt     DateTime?
  firstName      String?
  lastName       String?
  bio            String?
  avatarUrl      String?
  workouts       Workout[]
  templates      WorkoutTemplate[]
  sharesSent     WorkoutShare[]    @relation("SharesSent")
  sharesReceived WorkoutShare[]    @relation("SharesReceived")
  savedWorkouts    SavedWorkout[]
  favorites        FavoriteMovement[]
  favoriteWorkouts FavoriteWorkout[]
  weekPlans        WeekPlan[]
  workoutSessions  WorkoutSession[]
  following        Follow[]           @relation("Follower")
  followers        Follow[]           @relation("Followed")
  notifications    Notification[]
  assignedToMe     AssignedWorkout[]  @relation("AssignedTo")
  assignedByMe     AssignedWorkout[]  @relation("AssignedBy")
}

// Notification in-app. userId=null = broadcast (tous les users) — ex: annonce
// admin. Générée par le système uniquement (activation d'une annonce, assignation
// d'un WOD par le coach) : pas de création manuelle au départ, pour rester simple.
model Notification {
  id        String       @id @default(cuid())
  userId    String?
  title     String
  body      String?
  link      String?
  createdAt DateTime     @default(now())
  readAt    DateTime?
  user      InvitedUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// WOD assigné par un coach/admin à un user précis (mode "programme"). Pas de champ
// "done" stocké : la complétion se déduit en croisant avec WorkoutSession
// (même workoutId/userId, doneAt >= createdAt de l'assignation).
model AssignedWorkout {
  id           String      @id @default(cuid())
  workoutId    String
  workout      Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   InvitedUser @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   InvitedUser @relation("AssignedBy", fields: [assignedById], references: [id])
  note         String?
  scheduledFor DateTime?
  createdAt    DateTime    @default(now())

  @@index([assignedToId])

  @@index([workoutId])
  @@index([assignedById])
}

// Abonnement à un profil (pas à un workout précis) — sert uniquement à
// notifier par email les nouveaux workouts publiés par la personne suivie.
// Volontairement privé : pas de compteur d'abonnés public, pas de flux.
model Follow {
  id            String      @id @default(cuid())
  followerId    String
  followedId    String
  notifyByEmail Boolean     @default(true)
  createdAt     DateTime    @default(now())
  follower      InvitedUser @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed      InvitedUser @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])

  @@index([followedId])
}

model WeekPlan {
  id        String         @id @default(cuid())
  userId    String
  weekStart DateTime
  user      InvitedUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   WeekPlanEntry[]

  @@unique([userId, weekStart])
}

model WeekPlanEntry {
  id         String    @id @default(cuid())
  weekPlanId String
  workoutId  String
  dayOfWeek  Int       // 0=Lun … 6=Dim
  order      Int       @default(0)
  weekPlan   WeekPlan  @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  workout    Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([weekPlanId, dayOfWeek, order])
  @@index([workoutId])
}

model FavoriteMovement {
  id         String      @id @default(cuid())
  userId     String
  movementId String
  createdAt  DateTime    @default(now())
  user       InvitedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  movement   Movement    @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([userId, movementId])

  @@index([movementId])
}

model SavedWorkout {
  id           String      @id @default(cuid())
  workoutId    String
  workout      Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  userId       String
  user         InvitedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedAt      DateTime    @default(now())
  source       String      @default("manual") // "manual" | "shared"
  lastViewedAt DateTime?

  @@unique([workoutId, userId])

  @@index([userId, savedAt])
}

model WorkoutSession {
  id        String       @id @default(cuid())
  userId    String
  workoutId String
  doneAt    DateTime     @default(now())
  note      String?
  cut       String? // version faite (règle de coupe en JSON), null = séance complète
  user      InvitedUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets      SessionSet[]

  @@index([userId, doneAt])
  @@index([workoutId])
}

model SessionSet {
  id         String         @id @default(cuid())
  sessionId  String
  movementId String // l'exercice — permet l'historique cross-workout (pas de FK volontairement)
  setNumber  Int // n° de série, 1-based
  reps       Int?
  weight     Float? // charge en kg ; null = poids du corps / non renseigné
  rpe        Int? // ressenti 1-10, optionnel
  completed  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([movementId])
  @@index([sessionId])
}

model FavoriteWorkout {
  id        String      @id @default(cuid())
  userId    String
  workoutId String
  createdAt DateTime    @default(now())
  user      InvitedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutId])

  @@index([workoutId])
}

model AttributeOption {
  id       String @id @default(cuid())
  category String // 'bioType' | 'complexity' | 'equipment'
  value    String
  icon     String?
  color    String?
  position Int    @default(0)
  // Secondes par répétition, utilisé pour estimer la durée d'une série au nombre
  // de reps (category='bioType' uniquement). null = valeur par défaut globale.
  tempo    Float?

  @@unique([category, value])
}

// Échelons de difficulté du générateur (Novice / Intermédiaire / Avancé…).
// Paramétrable depuis Admin > Référentiels : chaque échelon liste les valeurs de
// complexité qu'il tire, pour que modifier l'échelle des complexités ne décale
// plus la génération (avant, le générateur indexait COMPLEXITIES[0..3] en dur).
model DifficultyTier {
  id           String @id @default(cuid())
  key          String @unique // identifiant stable utilisé par le générateur
  label        String // libellé affiché
  complexities String // JSON : ["Facile","Commun"] — valeurs de AttributeOption(category='complexity')
  sets         Int    @default(3)
  position     Int    @default(0)
}

// Contenu texte de la home, éditable depuis Admin > Contenus. key stable ("app_info",
// "announcement") ; active=false tant que l'admin n'a pas validé de texte à publier.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  url       String
  source    String
  category  String   // 'sport' | 'sante' | 'nutrition'
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model WorkoutShare {
  id             String       @id @default(cuid())
  workoutId      String
  workout        Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sharedByUserId String
  sharedByUser   InvitedUser  @relation("SharesSent", fields: [sharedByUserId], references: [id])
  sharedToEmail  String
  sharedToUserId String?
  sharedToUser   InvitedUser? @relation("SharesReceived", fields: [sharedToUserId], references: [id])
  token          String       @unique @default(cuid())
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?

  @@index([workoutId])
  @@index([sharedToUserId])
  @@index([sharedByUserId])
}
