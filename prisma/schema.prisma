generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Movement {
  id               String             @id
  name             String
  bioType          String
  complexity       String
  equipment        String?
  description      String?
  imageUrl         String?
  videoUrl         String?
  // Mouvement personnalisé créé "à la volée" par un utilisateur (nom + vidéo
  // seulement, id "custom-xxx") — jamais retourné par la recherche générale de
  // GET /api/movements, pour ne pas polluer la bibliothèque partagée.
  custom           Boolean            @default(false)
  createdByUserId  String?
  workoutMovements WorkoutMovement[]
  favorites        FavoriteMovement[]
}

model Workout {
  id          String            @id @default(cuid())
  name        String
  createdAt   DateTime          @default(now())
  duration    Int?
  notes       String?
  description String?
  imageUrl      String?
  imagePosition String? // "x% y%" (object-position CSS), null = centre par defaut
  templateId  String?
  userId      String?
  blockRest   Int?
  tags        String?
  public      Boolean           @default(false)
  // Difficulté forcée manuellement en édition — null = calcul auto
  // (computeWorkoutDifficulty) à partir des mouvements. Valeur libre parmi
  // COMPLEXITIES (Admin > Référentiels).
  difficultyOverride String?
  movements   WorkoutMovement[]
  blocks      WorkoutBlock[]
  shares      WorkoutShare[]
  savedBy     SavedWorkout[]
  favoritedBy FavoriteWorkout[]
  planEntries WeekPlanEntry[]
  sessions    WorkoutSession[]
  assignments AssignedWorkout[]
  template    WorkoutTemplate?  @relation(fields: [templateId], references: [id])
  user        InvitedUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WorkoutBlock {
  id           String            @id @default(cuid())
  workoutId    String
  order        Int
  bioType      String?
  instructions String?
  restAfter    Int?
  superset     Boolean           @default(false)
  workout      Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  movements    WorkoutMovement[]
}

model WorkoutMovement {
  id         String        @id @default(cuid())
  workoutId  String
  movementId String
  order      Int
  sets       Int?
  reps       String?
  rest       Int?
  duration   Int?
  blockId    String?
  movement   Movement      @relation(fields: [movementId], references: [id])
  workout    Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  block      WorkoutBlock? @relation(fields: [blockId], references: [id])
}

model WorkoutTemplate {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  userId    String?
  blocks    TemplateBlock[]
  workouts  Workout[]
  user      InvitedUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TemplateBlock {
  id         String          @id @default(cuid())
  templateId String
  bioType    String?
  complexity String?
  equipments String?
  count      Int
  order      Int
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model InvitedUser {
  id             String            @id @default(cuid())
  email          String            @unique
  token          String            @unique @default(cuid())
  loginToken     String?           @unique
  loginTokenExp  DateTime?
  status         String            @default("pending")
  invitedAt      DateTime          @default(now())
  acceptedAt     DateTime?
  firstName      String?
  lastName       String?
  bio            String?
  avatarUrl      String?
  workouts       Workout[]
  templates      WorkoutTemplate[]
  sharesSent     WorkoutShare[]    @relation("SharesSent")
  sharesReceived WorkoutShare[]    @relation("SharesReceived")
  savedWorkouts    SavedWorkout[]
  favorites        FavoriteMovement[]
  favoriteWorkouts FavoriteWorkout[]
  weekPlans        WeekPlan[]
  workoutSessions  WorkoutSession[]
  following        Follow[]           @relation("Follower")
  followers        Follow[]           @relation("Followed")
  notifications    Notification[]
  assignedToMe     AssignedWorkout[]  @relation("AssignedTo")
  assignedByMe     AssignedWorkout[]  @relation("AssignedBy")
}

// Notification in-app. userId=null = broadcast (tous les users) — ex: annonce
// admin. Générée par le système uniquement (activation d'une annonce, assignation
// d'un WOD par le coach) : pas de création manuelle au départ, pour rester simple.
model Notification {
  id        String       @id @default(cuid())
  userId    String?
  title     String
  body      String?
  link      String?
  createdAt DateTime     @default(now())
  readAt    DateTime?
  user      InvitedUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// WOD assigné par un coach/admin à un user précis (mode "programme"). Pas de champ
// "done" stocké : la complétion se déduit en croisant avec WorkoutSession
// (même workoutId/userId, doneAt >= createdAt de l'assignation).
model AssignedWorkout {
  id           String      @id @default(cuid())
  workoutId    String
  workout      Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   InvitedUser @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   InvitedUser @relation("AssignedBy", fields: [assignedById], references: [id])
  note         String?
  scheduledFor DateTime?
  createdAt    DateTime    @default(now())

  @@index([assignedToId])
}

// Abonnement à un profil (pas à un workout précis) — sert uniquement à
// notifier par email les nouveaux workouts publiés par la personne suivie.
// Volontairement privé : pas de compteur d'abonnés public, pas de flux.
model Follow {
  id            String      @id @default(cuid())
  followerId    String
  followedId    String
  notifyByEmail Boolean     @default(true)
  createdAt     DateTime    @default(now())
  follower      InvitedUser @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed      InvitedUser @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
}

model WeekPlan {
  id        String         @id @default(cuid())
  userId    String
  weekStart DateTime
  user      InvitedUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   WeekPlanEntry[]

  @@unique([userId, weekStart])
}

model WeekPlanEntry {
  id         String    @id @default(cuid())
  weekPlanId String
  workoutId  String
  dayOfWeek  Int       // 0=Lun … 6=Dim
  order      Int       @default(0)
  weekPlan   WeekPlan  @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  workout    Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model FavoriteMovement {
  id         String      @id @default(cuid())
  userId     String
  movementId String
  createdAt  DateTime    @default(now())
  user       InvitedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  movement   Movement    @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([userId, movementId])
}

model SavedWorkout {
  id           String      @id @default(cuid())
  workoutId    String
  workout      Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  userId       String
  user         InvitedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedAt      DateTime    @default(now())
  source       String      @default("manual") // "manual" | "shared"
  lastViewedAt DateTime?

  @@unique([workoutId, userId])
}

model WorkoutSession {
  id        String       @id @default(cuid())
  userId    String
  workoutId String
  doneAt    DateTime     @default(now())
  note      String?
  user      InvitedUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets      SessionSet[]
}

model SessionSet {
  id         String         @id @default(cuid())
  sessionId  String
  movementId String // l'exercice — permet l'historique cross-workout (pas de FK volontairement)
  setNumber  Int // n° de série, 1-based
  reps       Int?
  weight     Float? // charge en kg ; null = poids du corps / non renseigné
  rpe        Int? // ressenti 1-10, optionnel
  completed  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([movementId])
  @@index([sessionId])
}

model FavoriteWorkout {
  id        String      @id @default(cuid())
  userId    String
  workoutId String
  createdAt DateTime    @default(now())
  user      InvitedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutId])
}

model AttributeOption {
  id       String @id @default(cuid())
  category String // 'bioType' | 'complexity' | 'equipment'
  value    String
  icon     String?
  color    String?
  position Int    @default(0)
  // Secondes par répétition, utilisé pour estimer la durée d'une série au nombre
  // de reps (category='bioType' uniquement). null = valeur par défaut globale.
  tempo    Float?

  @@unique([category, value])
}

// Échelons de difficulté du générateur (Novice / Intermédiaire / Avancé…).
// Paramétrable depuis Admin > Référentiels : chaque échelon liste les valeurs de
// complexité qu'il tire, pour que modifier l'échelle des complexités ne décale
// plus la génération (avant, le générateur indexait COMPLEXITIES[0..3] en dur).
model DifficultyTier {
  id           String @id @default(cuid())
  key          String @unique // identifiant stable utilisé par le générateur
  label        String // libellé affiché
  complexities String // JSON : ["Facile","Commun"] — valeurs de AttributeOption(category='complexity')
  sets         Int    @default(3)
  position     Int    @default(0)
}

// Contenu texte de la home, éditable depuis Admin > Contenus. key stable ("app_info",
// "announcement") ; active=false tant que l'admin n'a pas validé de texte à publier.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model WorkoutShare {
  id             String       @id @default(cuid())
  workoutId      String
  workout        Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sharedByUserId String
  sharedByUser   InvitedUser  @relation("SharesSent", fields: [sharedByUserId], references: [id])
  sharedToEmail  String
  sharedToUserId String?
  sharedToUser   InvitedUser? @relation("SharesReceived", fields: [sharedToUserId], references: [id])
  token          String       @unique @default(cuid())
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
}
